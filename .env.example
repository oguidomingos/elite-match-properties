# ---- Elite Match Properties (copie para .env e preencha) ----
NODE_ENV=production
PORT=3071
HOST=127.0.0.1

# Postgres dedicado (docker elite-match-db). Gere uma senha forte.
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://elitematch:troque-esta-senha@127.0.0.1:5435/elitematch

# Sessão (openssl rand -hex 32)
SESSION_SECRET=troque-por-um-hex-de-64-chars
SESSION_TTL_DAYS=30

# OTP
OTP_TTL_MINUTES=10

# Evolution API (WhatsApp OTP)
EVOLUTION_URL=http://127.0.0.1:8083
EVOLUTION_APIKEY=coloque-a-apikey-da-evolution
EVOLUTION_INSTANCE=trion-cold

# Corretor(es) admin — WhatsApp só dígitos (DDI+DDD+numero), separados por vírgula
ADMIN_WHATSAPP=556199449983

# Origin público (ajuste ao domínio final; use https em produção real)
PUBLIC_ORIGIN=http://127.0.0.1:3071
